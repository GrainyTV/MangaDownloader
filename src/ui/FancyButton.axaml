<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="MangaDownloader.FancyButton"
    x:Name="root">

    <Border Background="Transparent">
        <Button CornerRadius="{Binding #root.CornerRadius}" Command="{Binding #root.Command}">
            <TextBlock Text="{Binding #root.Label}" />
        </Button>
    </Border>

</UserControl>
